{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-todo",
  "version": "0.1.0",
  "identifier": "com.desktop-todo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
    "app": {
    "windows": [
      {
        "title": "Pixel Todo",
        "width": 360,
        "height": 465,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true
      }
    ]
    },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
